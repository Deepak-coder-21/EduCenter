# MongoDB Connection String (Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/educenter?retryWrites=true&w=majority

# Port (Hosting platforms like Render, Railway assign PORT automatically)
PORT=5000

# Secret key for signing JWT tokens (use a long, random string)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL(s) for CORS & Cookies (comma-separated if multiple, no trailing slash)
CLIENT_URL=http://localhost:5173,https://your-frontend-app.vercel.app

# Node Environment ('production' in production)
NODE_ENV=production

# Cloudinary Setup for media & lecture notes upload
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
CLOUD_NAME=your_cloudinary_cloud_name

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email / SMTP Setup for OTP Verification (e.g. Gmail App Password or Brevo/Resend)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
